# ─── Supabase (required) ────────────────────────────────────────────────────
# Copy this file to .env and fill in your project values.
# Find these in: https://supabase.com/dashboard/project/<YOUR_PROJECT>/settings/api
#
# VITE_ prefix   → bundled into the browser client (safe: public anon key only)
# No VITE_ prefix → only available in SSR / server functions (never in browser)

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# ─── Supabase Admin (optional — only needed for account deletion) ────────────
# Find this in: https://supabase.com/dashboard/project/<YOUR_PROJECT>/settings/api
# ⚠️  NEVER expose this to the browser. Only use in .server.ts files.
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."
